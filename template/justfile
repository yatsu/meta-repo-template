set positional-arguments

# Lets wt-* recipes find the worktree set they are run from; [branch] can be omitted inside worktrees/<branch>/
export META_INVOCATION_DIR := invocation_directory()

# List recipes
help:
    @just --list --unsorted

# Clone repos from repos.txt into repos/ (skips existing ones)
bootstrap *repos:
    @scripts/bootstrap.sh "$@"

# Fetch, then fast-forward pull repos without uncommitted changes
sync *repos:
    @scripts/sync.sh "$@"

# Show branch, uncommitted changes, and ahead/behind per repo
status *repos:
    @scripts/status.sh "$@"

# Run a command in each repo root (e.g. just exec 'git log -1 --oneline')
exec cmd *repos:
    @scripts/exec.sh "$@"

# Add a repo to repos.txt and clone it
add name url branch="":
    @scripts/add.sh "$@"

# Create same-branch worktrees under worktrees/<branch>/<repo>/ (repo@base sets the base)
wt-new branch *repos:
    @scripts/wt-new.sh "$@"

# [branch] [repo...]: Show status of a worktree set, including each repo's base
wt-status *args:
    @scripts/status.sh -w "$@"

# [branch] [repo...]: List commits on top of each worktree's base
wt-log *args:
    @scripts/wt-log.sh "$@"

# [branch] [repo...] [--stat]: Diff from each worktree's base to its working tree, uncommitted included
wt-diff *args:
    @scripts/wt-diff.sh base "$@"

# [branch] [repo...] [--stat]: Diff of uncommitted changes in each worktree, staged or not
wt-diff-head *args:
    @scripts/wt-diff.sh head "$@"

# [branch] [repo...] [--stat]: Diff a pull request against each worktree's base would show
wt-diff-pr *args:
    @scripts/wt-diff.sh pr "$@"

# [branch] '<cmd>' [repo...]: Run a command in each worktree, with BASE and BASE_REF set
wt-exec *args:
    @scripts/wt-exec.sh "$@"

# [branch] [repo...]: Fast-forward each worktree's local base branch to it, without pushing
wt-merge *args:
    @scripts/wt-merge.sh "$@"

# [branch] [repo...]: Push each worktree's local base branch to origin (no force)
wt-push-base *args:
    @scripts/wt-push-base.sh "$@"

# List worktree sets and the repos in each
wt-list:
    @scripts/wt-list.sh

# Remove a worktree set and its unused branches (--force discards changes)
wt-rm branch *flags:
    @scripts/wt-rm.sh "$@"
